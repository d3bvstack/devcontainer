{
  "name": "Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
    ,"args": {
      "USER_UID": "${localEnv:UID:-1000}",
      "USER_GID": "${localEnv:GID:-1000}",
      "USERNAME": "${localEnv:USER:-vscode}"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "cschlosser.doxdocgen"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends build-essential python3-pip fzf zip unzip procps iproute2 iputils-ping && sudo apt-get clean && sudo rm -rf /var/lib/apt/lists/*",
  "forwardPorts": [8000],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "updateRemoteUserUID": true,

  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent.sock,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent.sock"
  },

  "remoteUser": "${localEnv:USER:-vscode}"
}
